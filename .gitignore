# 常用.gitignore文件书写
# =========================
# 1. Python 缓存文件
# =========================
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# =========================
# 2. 环境变量与敏感信息
# =========================
.env
.env.*
!.env.example
*.pem
*.key

# =========================
# 3. Python 虚拟环境
# =========================
.venv/
venv/
env/

# =========================
# 4. IDE 配置
# =========================
.idea/
.vscode/

# =========================
# 5. 日志与临时文件
# =========================
*.log
logs/
tmp/
temp/

# =========================
# 6. Agent 运行产生的数据
# =========================
chroma_db/
vector_store/
checkpoints/
outputs/

# =========================
# 7. 本地数据库
# =========================
*.db
*.sqlite
*.sqlite3

# =========================
# 8. 系统文件
# =========================
.DS_Store
Thumbs.db
